# agenttrain AI 代理服务端配置
# 复制本文件为 server/.env 并填入真实值。key 仅存在本地服务端，绝不进入浏览器。

# OpenAI 兼容的服务地址（去掉末尾斜杠）
AGENTTRAIN_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# API Key。留空 → 代理对 /api/chat 返回 503，前端自动回退到离线 Mock 模式。
AGENTTRAIN_LLM_API_KEY=你的key

# 模型名（建议用快速便宜的模型，因为调用频繁）
AGENTTRAIN_LLM_MODEL=glm-4-flash

# 失败重试次数（仅对 429/5xx/网络错误重试）
AGENTTRAIN_LLM_RETRIES=3

# 代理监听端口（默认 5174）
AGENTTRAIN_PORT=5174
